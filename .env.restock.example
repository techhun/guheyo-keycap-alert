# Discord application
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Recommended during setup so slash commands appear immediately in this server.
DISCORD_GUILD_ID=

# Discord channels / authorization
RESTOCK_MANAGE_CHANNEL_ID=
RESTOCK_ALERT_CHANNEL_ID=
# Optional comma-separated Discord user IDs. If empty, Manage Server permission is required.
RESTOCK_ALLOWED_USER_IDS=
RESTOCK_POLL_SECONDS=60

# GitHub-backed watchlist/state storage for the always-on bot
RESTOCK_GITHUB_REPOSITORY=techhun/keyboard-alert
RESTOCK_GITHUB_TOKEN=
RESTOCK_GITHUB_BRANCH=main

# SmartStore browser runtime
RESTOCK_BROWSER_CHANNEL=chrome
# Optional but recommended for a long-running SmartStore watcher.
# Keep this directory private; it can contain cookies/session data.
RESTOCK_BROWSER_PROFILE_DIR=.restock-browser
